{
  "name": "magpie-opc-auth",
  "version": "0.1.6",
  "description": "magpie / OpenCode provider plugin for FiimeOPC (opc.fiime.cn): browser-cookie sign-in, Token wallet + daily quota card, daily check-in, and an OpenAI-compatible chat channel backed by the site's own API keys.",
  "type": "module",
  "main": "./index.mjs",
  "exports": "./index.mjs",
  "files": [
    "index.mjs",
    "src",
    "docs",
    "README.md",
    "README-TEMPLATE.md",
    "AGENTS.md",
    "CHECKLIST.md",
    "HOOKS.md",
    "UPDATING.md",
    "CHANGELOG.md",
    "MULTI-PROVIDER.md",
    "NOTICE.md",
    "LICENSE",
    "extract-contract.py",
    "registry-entry.json",
    "tests",
    "scripts",
    "examples",
    "ERROR-CODES.md",
    "GUIDE.md",
    "OFFICIAL-SOURCES.md",
    "SCORING.md",
    "CONTRIBUTING.md",
    "MAINTENANCE.md"
  ],
  "keywords": [
    "magpie",
    "magpie-plugin",
    "opencode",
    "opencode-plugin",
    "opencode-auth",
    "provider",
    "fiimeopc",
    "opc",
    "one-person-company",
    "checkin",
    "token-quota"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYCF711/magpie-opc-auth.git"
  },
  "bugs": {
    "url": "https://github.com/MYCF711/magpie-opc-auth/issues"
  },
  "homepage": "https://github.com/MYCF711/magpie-opc-auth#readme",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "magpie": {
    "icon": "data:image/svg+xml;base64,",
    "maxConcurrency": 4,
    "name": "一人公司社区 FiimeOPC"
  },
  "scripts": {
    "test": "node --test",
    "check": "node scripts/check.mjs",
    "check:errors": "node scripts/check-error-codes.mjs .",
    "release": "node scripts/release.mjs",
    "score": "node scripts/score.mjs",
    "maintenance": "node scripts/check-maintenance.mjs",
    "publish:npm": "node scripts/publish-npm.mjs",
    "check:ua": "node scripts/check-ua.mjs ."
  }
}
